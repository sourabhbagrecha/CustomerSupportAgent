{
  "name": "fde-support-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade customer support agent: LangGraph.js agent, deterministic money path, fault injection, evals, observability.",
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/src/index.ts\" \"vite\"",
    "build:web": "vite build",
    "demo": "npm run build:web && cross-env NODE_ENV=production tsx server/src/index.ts",
    "eval": "vitest run --config vitest.eval.config.ts; ec=$?; tsx scripts/export-results.ts; exit $ec",
    "test": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@langchain/core": "1.2.8",
    "@langchain/langgraph": "1.4.10",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.3",
    "@langchain/openai": "1.5.8",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.0",
    "@fastify/cors": "11.0.1",
    "@fastify/static": "10.1.3",
    "openai": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.2.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.5",
    "cross-env": "7.0.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}

# Copy this file to .env and fill in your own key: cp .env.example .env

# Required. Your OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=sk-...

# Required. PRIMARY_MODEL, verified against OpenAI's pricing/docs as of 2026-08-19.
PRIMARY_MODEL=gpt-5.4

# Required. What the agent fails over to on primary timeout/429/5xx. For real
# resilience this should be a genuinely different provider/family than
# PRIMARY_MODEL, not just a cheaper model from the same vendor: if the vendor
# itself is down (not just one model), a same-vendor fallback goes down with
# it. An id containing "/" (OpenRouter's "vendor/model" naming, e.g. the one
# below) is routed to OPENROUTER_BASE_URL using OPENROUTER_API_KEY, regardless
# of OPENAI_BASE_URL; an OpenAI-style id with no "/" keeps calling
# OPENAI_BASE_URL with OPENAI_API_KEY as before. FALLBACK_MODEL may also be
# set to the same vendor/ID as PRIMARY_MODEL (failover logic still exercises
# retry/backoff, just without a provider-outage safety net).
FALLBACK_MODEL=google/gemini-3.7-flash

# Required when FALLBACK_MODEL (or PRIMARY_MODEL) is an OpenRouter-style
# "vendor/model" id, as FALLBACK_MODEL is by default above. Get a key at
# https://openrouter.ai/keys. If you would rather not hold a second key, set
# FALLBACK_MODEL to an OpenAI-style id instead and leave this unset.
OPENROUTER_API_KEY=sk-or-...

# Optional. Fastify port. Defaults to 3000 if unset.
PORT=3000

# Optional. Base URL of any OpenAI-compatible chat-completions endpoint the
# agent should call, instead of OpenAI, for OpenAI-style model IDs (a pasted
# ".../chat/completions" suffix is trimmed automatically). Defaults to
# https://api.openai.com/v1 when unset. PRIMARY_MODEL must then be a model ID
# that endpoint accepts, and OPENAI_API_KEY must be that provider's key. Does
# not affect OpenRouter-style ("vendor/model") IDs, which always route to
# OPENROUTER_BASE_URL (https://openrouter.ai/api/v1) regardless of this.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Required. Pins the eval judge to its own model/provider, independent of
# FALLBACK_MODEL, so runs against different agent models are still graded by
# the same judge and so the judge is never dragged along when FALLBACK_MODEL
# is changed for the agent's own failover (an unrelated concern; see above).
# JUDGE_MODEL is set by default here because leaving it unset falls back to
# FALLBACK_MODEL, which above defaults to an OpenRouter-style id; the judge
# would then need OPENROUTER_API_KEY and OpenRouter's base URL just to grade
# evals, for no reason related to grading quality. Set to an OpenAI-style id
# verified against OpenAI's pricing/docs as of 2026-08-19.
JUDGE_MODEL=gpt-5.4-mini

# Optional. JUDGE_BASE_URL / JUDGE_API_KEY default to OPENAI_BASE_URL /
# OPENAI_API_KEY when unset, which is correct as long as JUDGE_MODEL above
# stays an OpenAI-style id. If you deliberately set JUDGE_MODEL to an
# OpenRouter-style "vendor/model" id instead, evals/judge.ts routes it to
# OPENROUTER_BASE_URL using OPENROUTER_API_KEY automatically (same "/"-based
# routing PRIMARY_MODEL/FALLBACK_MODEL use above), unless you set
# JUDGE_BASE_URL / JUDGE_API_KEY explicitly here, which always wins.
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=sk-...

# Optional. Extra provider keys for eval runs started from the app's Evals tab.
# Any variable ending in _API_KEY that is set here is offered by NAME in the
# run launcher (OPENROUTER_API_KEY above already qualifies); the value never
# leaves the server.

# Copy this file to .env and fill in your own key: cp .env.example .env

# Required. Your OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=sk-...

# Required. Two model IDs, verified against OpenAI's pricing/docs as of 2026-08-19.
# PRIMARY_MODEL should be the stronger model; FALLBACK_MODEL the cheaper one the
# agent fails over to on primary timeout/429/5xx. They may be set to the same ID
# (failover logic still exercises retry/backoff, just without a capability drop).
PRIMARY_MODEL=gpt-5.4
FALLBACK_MODEL=gpt-5.4-mini

# Optional. Fastify port. Defaults to 3000 if unset.
PORT=3000

# Optional. Base URL of any OpenAI-compatible chat-completions endpoint the
# agent should call instead of OpenAI (OpenRouter is https://openrouter.ai/api/v1;
# a pasted ".../chat/completions" suffix is trimmed automatically). Defaults to
# https://api.openai.com/v1 when unset. PRIMARY_MODEL / FALLBACK_MODEL must then
# be model IDs that endpoint accepts, and OPENAI_API_KEY must be that provider's key.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional. Pin the eval judge to one model/provider so runs against different
# agent models are still graded by the same judge. Each defaults to the agent's
# own setting (FALLBACK_MODEL, OPENAI_BASE_URL, OPENAI_API_KEY) when unset.
# JUDGE_MODEL=gpt-5.4-mini
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=sk-...

# Optional. Extra provider keys for eval runs started from the app's Evals tab.
# Any variable ending in _API_KEY that is set here is offered by NAME in the
# run launcher; the value never leaves the server.
# OPENROUTER_API_KEY=sk-or-...
